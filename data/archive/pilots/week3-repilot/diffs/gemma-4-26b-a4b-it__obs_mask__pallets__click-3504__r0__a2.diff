+
+import os
+
+class CompletionItem:
+    def __init__(self, type, value, help=None):
+        self.type = type
+        self.value = value
+        self.help = help
+
+class FishComplete:
+    def format_completion(self, item: CompletionItem) -> str:
+        help_ = item.help or "_"
+        value = item.value.replace("\n", r"\n")
+        help_escaped = help_.replace("\n", r"\n")
+        return f"{item.type}\n{value}\n{help_escaped}"
+
+def simulate_fish_completion(response_str):
+    # This simulates the fish script logic
+    # for completion in $response;
+    #     set -l metadata (string split \n $completion);
+    #     ...
+    # end
+    
+    # In fish, 'for completion in $response' splits by whitespace.
+    # We'll use .split() which is similar to fish's default behavior for unquoted variables.
+    completions = response_str.split()
+    
+    for completion in completions:
+        # set -l metadata (string split \n $completion);
+        # In fish, string split \n $completion where $completion has no \n is just $completion
+        metadata = completion.split('\n')
+        
+        print(f"DEBUG: completion='{completion}'")
+        print(f"DEBUG: metadata={metadata}")
+        
+        if len(metadata) > 0:
+            m1 = metadata[0]
+            print(f"DEBUG: m1='{m1}'")
+            if m1 == "dir":
+                pass
+            elif m1 == "file":
+                pass
+            elif m1 == "plain":
+                if len(metadata) > 2:
+                    m2 = metadata[1]
+                    m3 = metadata[2]
+                    print(f"DEBUG: m2='{m2}', m3='{m3}'")
+                else:
+                    print("DEBUG: metadata too short for plain")
+            else:
+                print(f"DEBUG: unknown type '{m1}'")
+
+if __name__ == "__main__":
+    item = CompletionItem("plain", "--at", "Attachment with explicit mimetype,\n--at image.jpg image/jpeg")
+    fc = FishComplete()
+    response = fc.format_completion(item)
+    print("--- Response ---")
+    print(response)
+    print("--- Simulation ---")
+    simulate_fish_completion(response)
