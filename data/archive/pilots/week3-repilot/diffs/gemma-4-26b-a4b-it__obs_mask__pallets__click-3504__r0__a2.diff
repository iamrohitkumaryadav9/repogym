+import click
+import os
+from click.shell_completion import FishComplete, CompletionItem
+
+@click.command()
+@click.option(
+    "attachment_types",
+    "--at",
+    "--attachment-type",
+    type=(str, str),
+    multiple=True,
+    help="\nAttachment with explicit mimetype,\n--at image.jpg image/jpeg",
+)
+def test_cmd(attachment_types):
+    pass
+
+def reproduce():
+    # Mocking the environment for fish completion
+    os.environ["COMP_WORDS"] = "llm --"
+    os.environ["COMP_CWORD"] = "--"
+    os.environ["_LLM_COMPLETE"] = "fish_complete"
+
+    # We want to see what FishComplete.format_completion produces for the '--at' option
+    # In a real click completion, click will find the option and create CompletionItem
+    
+    # For the purpose of reproduction, let's manually create CompletionItem
+    item = CompletionItem(type="plain", value="--at", help="Attachment with explicit mimetype,\n--at image.jpg image/jpeg")
+    
+    fc = FishComplete()
+    result = fc.format_completion(item)
+    print("FishComplete.format_completion result:")
+    print(repr(result))
+    print("FishComplete.format_completion result (as string):")
+    print(result)
+
+if __name__ == "__main__":
+    reproduce()
