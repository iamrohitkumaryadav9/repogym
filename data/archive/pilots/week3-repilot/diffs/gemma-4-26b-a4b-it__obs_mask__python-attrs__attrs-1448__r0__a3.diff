+++ b/reproduce_issue.py
@@ -0,0 +1,46 @@
+from typing import Dict, Any
+from attrs import define, field
+from attrs.validators import deep_mapping
+
+@define
+class B:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            key_validator=lambda k: isinstance(k, str) and len(k) > 0,
+        )
+    )
+
+try:
+    b = B(x={"a": 1})
+    print("Success (B)!")
+except Exception as e:
+    print(f"Failed (B): {e}")
+
+@define
+class C:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            value_validator=lambda v: isinstance(v, int),
+        )
+    )
+
+try:
+    c = C(x={"a": 1})
+    print("Success (C)!")
+except Exception as e:
+    print(f"Failed (C): {e}")
+
+@define
+class D:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            key_validator=lambda k: isinstance(k, str) and len(k) > 0,
+            value_validator=lambda v: isinstance(v, int),
+        )
+    )
+
+try:
+    d = D(x={"a": 1})
+    print("Success (D)!")
+except Exception as e:
+    print(f"Failed (D): {e}")
