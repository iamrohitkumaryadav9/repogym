diff --git a/tests/test_issue_reproduction.py b/tests/test_issue_reproduction.py
new file mode 100644
index 0000000..e771ebe
--- /dev/null
+++ b/tests/test_issue_reproduction.py
@@ -0,0 +1,49 @@
+import pytest
+from typing import Dict, Any
+from attrs import define, field, instance_of, and_
+from attr.validators import deep_mapping, min_len
+
+@define
+class B:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            key_validator=and_(instance_of(str), min_len(1)),
+        )
+    )
+
+def test_deep_mapping_only_key_validator():
+    b = B(x={"a": 1, "b": 2})
+    assert b.x == {"a": 1, "b": 2}
+
+    with pytest.raises(ValueError):
+        B(x={1: "a"})
+
+    with pytest.raises(ValueError):
+        B(x={"": "a"})
+
+@define
+class C:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            value_validator=instance_of(int),
+        )
+    )
+
+def test_deep_mapping_only_value_validator():
+    c = C(x={"a": 1, "b": 2})
+    assert c.x == {"a": 1, "b": 2}
+
+    with pytest.raises(ValueError):
+        C(x={"a": "1"})
+
+@define
+class D:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+        )
+    )
+
+def test_deep_mapping_no_validators():
+    with pytest.raises(TypeError, match="At least one of `key_validator` or `value_validator` must be provided."):
+        D(x={"a": 1})
+
