@@ -0,0 +1,55 @@
+from attrs import define, field
+from typing import Dict, Any
+import attr
+
+# We need to import deep_mapping from attr.validators
+from attr.validators import deep_mapping
+
+@define
+class B:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            key_validator=lambda k: isinstance(k, str) and len(k) > 0,
+            # value_validator=lambda v: None, # This is what the user had to do
+        )
+    )
+
+try:
+    b = B(x={"a": 1})
+    print("Success!")
+except Exception as e:
+    print(f"Failed: {e}")
+
+@define
+class C:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            # key_validator=lambda k: isinstance(k, str) and len(k) > 0,
+            value_validator=lambda v: isinstance(v, int),
+        )
+    )
+
+try:
+    c = C(x={"a": 1})
+    print("Success!")
+except Exception as e:
+    print(f"Failed: {e}")
+
+try:
+    d = C(x={"a": "not_int"})
+    print("Success!")
+except Exception as e:
+    print(f"Failed: {e}")
+
+@define
+class E:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping()
+    )
+
+try:
+    e = E(x={"a": 1})
+    print("Success!")
+except Exception as e:
+    print(f"Failed: {e}")
+
