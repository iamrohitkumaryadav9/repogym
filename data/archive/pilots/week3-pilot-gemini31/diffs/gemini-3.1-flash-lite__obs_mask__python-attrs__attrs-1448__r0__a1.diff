index 0000000..f4436b1
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,70 @@
+from attr import define, field
+from attr.validators import deep_mapping, instance_of, min_len, and_
+from typing import Dict, Any
+
+# This should still work
+@define
+class B:
+    x: Dict[str, Any] = field(
+        validator=deep_mapping(
+            key_validator=and_(instance_of(str), min_len(1)),
+            value_validator=lambda *x: None,
+        )
+    )
+
+# The user wants to do this now (only validating keys)
+try:
+    @define
+    class C:
+        x: Dict[str, Any] = field(
+            validator=deep_mapping(
+                key_validator=and_(instance_of(str), min_len(1)),
+            )
+        )
+    print("Successfully defined C")
+except Exception as e:
+    print(f"Failed to define C: {e}")
+
+# The user wants to do this now (only validating values)
+try:
+    @define
+    class D:
+        x: Dict[str, Any] = field(
+            validator=deep_mapping(
+                value_validator=instance_of(int),
+            )
+        )
+    print("Successfully defined D")
+except Exception as e:
+    print(f"Failed to define D: {e}")
+    
+# This should fail
+try:
+    @define
+    class E:
+        x: Dict[str, Any] = field(
+            validator=deep_mapping()
+        )
+    print("Successfully defined E (should not happen)")
+except Exception as e:
+    print(f"Failed to define E (expected): {e}")
+
+# Verify functionality
+b = B(x={"a": 1})
+print(f"B: {b}")
+
+c = C(x={"a": 1, "b": 2})
+print(f"C: {c}")
+
+d = D(x={"a": 1, "b": 2})
+print(f"D: {d}")
+
+try:
+    C(x={1: 1}) # Should fail validation
+except Exception as e:
+    print(f"Validation failed as expected for C: {e}")
+
+try:
+    D(x={"a": "string"}) # Should fail validation
+except Exception as e:
+    print(f"Validation failed as expected for D: {e}")
