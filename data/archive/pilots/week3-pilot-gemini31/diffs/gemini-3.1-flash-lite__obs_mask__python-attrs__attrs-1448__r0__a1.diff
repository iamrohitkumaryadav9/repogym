diff --git a/tests/test_deep_mapping_optional.py b/tests/test_deep_mapping_optional.py
new file mode 100644
index 0000000..eaf8568
--- /dev/null
+++ b/tests/test_deep_mapping_optional.py
@@ -0,0 +1,49 @@
+import pytest
+from attr.validators import deep_mapping, instance_of
+from attr import define, field, Attribute
+
+dummy_attr = Attribute(
+    name="dummy",
+    default=None,
+    validator=None,
+    repr=True,
+    cmp=True,
+    hash=None,
+    init=True,
+    kw_only=False,
+    converter=None,
+    metadata=None,
+    type=None,
+    inherited=False,
+    on_setattr=None,
+)
+
+def test_optional_validators():
+    # Only key validator
+    v_key = deep_mapping(key_validator=instance_of(str))
+    v_key(None, dummy_attr, {"a": 1, "b": 2})
+    with pytest.raises(TypeError):
+        v_key(None, dummy_attr, {1: 1})
+    
+    # Only value validator
+    v_val = deep_mapping(value_validator=instance_of(int))
+    v_val(None, dummy_attr, {"a": 1, "b": 2})
+    with pytest.raises(TypeError):
+        v_val(None, dummy_attr, {"a": "string"})
+        
+    # Both missing
+    with pytest.raises(ValueError):
+        deep_mapping()
+
+def test_repr_optional():
+    # Only key validator
+    key_validator = instance_of(str)
+    v = deep_mapping(key_validator=key_validator)
+    expected_repr = f"<deep_mapping validator for objects mapping {key_validator!r} to None>"
+    assert expected_repr == repr(v)
+    
+    # Only value validator
+    value_validator = instance_of(int)
+    v = deep_mapping(value_validator=value_validator)
+    expected_repr = f"<deep_mapping validator for objects mapping None to {value_validator!r}>"
+    assert expected_repr == repr(v)
