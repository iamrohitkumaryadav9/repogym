--- /dev/null
+++ b/test_repro.py
@@ -0,0 +1,12 @@
+
+from click.shell_completion import CompletionItem, FishComplete
+
+def test_fish_output():
+    comp = FishComplete(None, {}, "llm", "_LLM_COMPLETE")
+    item = CompletionItem("--at", "plain", "Attachment with explicit mimetype,\n--at image.jpg image/jpeg")
+    # FishComplete format_completion uses item.value and item.help.
+    # The order of arguments to CompletionItem constructor is (value, help, type)
+    # Wait, let me check CompletionItem constructor.
+    print(f"Output: {comp.format_completion(item)!r}")
+
+test_fish_output()
diff --git a/test_repro_debug.py b/test_repro_debug.py
new file mode 100644
index 0000000..93174f2
--- /dev/null
+++ b/test_repro_debug.py
@@ -0,0 +1,24 @@
+
+from click.shell_completion import CompletionItem
+from click.testing import CliRunner
+import click
+
+def test_repro():
+    item = CompletionItem(
+        "at",
+        "plain",
+        help="\b\nAttachment with explicit mimetype,\n--at image.jpg image/jpeg",
+    )
+    
+    print(f"item.help repr: {repr(item.help)}")
+    
+    help_ = item.help or "_"
+    value = item.value.replace("\n", r"\n")
+    help_escaped = help_.replace("\n", r"\n")
+    
+    print(f"help_escaped repr: {repr(help_escaped)}")
+    
+    output = f"{item.type}\n{value}\n{help_escaped}"
+    print(f"output repr: {repr(output)}")
+
+test_repro()
