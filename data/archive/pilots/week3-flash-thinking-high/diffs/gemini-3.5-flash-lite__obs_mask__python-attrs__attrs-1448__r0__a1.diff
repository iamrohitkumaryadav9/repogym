diff --git a/tests/test_validators.py b/tests/test_validators.py
index 45e7050..64b98e2 100644
--- a/tests/test_validators.py
+++ b/tests/test_validators.py
@@ -721,6 +721,64 @@ class TestDeepMapping:
         )
         assert expected_repr == repr(v)
 
+    def test_key_validator_only(self):
+        """
+        Validate keys only when value_validator is None.
+        """
+        key_validator = instance_of(str)
+        v = deep_mapping(key_validator=key_validator)
+        a = simple_attr("test")
+        v(None, a, {"a": "any_value", "b": 123})
+        with pytest.raises(TypeError):
+            v(None, a, {42: "any_value"})
+
+    def test_value_validator_only(self):
+        """
+        Validate values only when key_validator is None.
+        """
+        value_validator = instance_of(int)
+        v = deep_mapping(value_validator=value_validator)
+        a = simple_attr("test")
+        v(None, a, {"any_key": 6, 42: 7})
+        with pytest.raises(TypeError):
+            v(None, a, {"any_key": "not_int"})
+
+    def test_neither_validator_raises_value_error(self):
+        """
+        Raise ValueError if neither key_validator nor value_validator is provided.
+        """
+        with pytest.raises(
+            ValueError,
+            match="Must provide at least one of key_validator or value_validator.",
+        ):
+            deep_mapping()
+
+    def test_repr_key_only(self):
+        """
+        Returned validator has a useful `__repr__` when only key_validator is provided.
+        """
+        key_validator = instance_of(str)
+        key_repr = "<instance_of validator for type <class 'str'>>"
+        v = deep_mapping(key_validator=key_validator)
+        expected_repr = (
+            "<deep_mapping validator for objects mapping "
+            f"{key_repr} to values>"
+        )
+        assert expected_repr == repr(v)
+
+    def test_repr_value_only(self):
+        """
+        Returned validator has a useful `__repr__` when only value_validator is provided.
+        """
+        value_validator = instance_of(int)
+        value_repr = "<instance_of validator for type <class 'int'>>"
+        v = deep_mapping(value_validator=value_validator)
+        expected_repr = (
+            "<deep_mapping validator for objects mapping "
+            f"keys to {value_repr}>"
+        )
+        assert expected_repr == repr(v)
+
 
